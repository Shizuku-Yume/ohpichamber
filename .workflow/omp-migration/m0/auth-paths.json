  "interpretation": {
    "default": "No-argument getAgentDbPath() resolves <HOME>/.omp/agent/agent.db.",
    "xdgWithoutOmpDirectories": "Setting XDG_CONFIG_HOME/XDG_DATA_HOME/XDG_CACHE_HOME alone does not redirect the database; missing omp app directories leave the HOME default selected.",
    "xdgWithOmpDirectories": "Pre-existing <XDG_DATA_HOME>/omp selects <XDG_DATA_HOME>/omp/agent.db. XDG_CONFIG_HOME does not select an auth path. XDG_CACHE_HOME contains observed Bun caches, not agent.db.",
    "environmentOverride": "PI_CODING_AGENT_DIR overrides no-argument path even when initialized XDG app directories exist.",
    "argumentOverride": "Separate getAgentDbPath(explicitDirectory) selects <ARG_OVERRIDE>/agent.db; no-argument path in that process still selects initialized XDG data.",
    "authStorage": "create(selectedPath) and close() returned for ten fresh isolated cases. Each created a new regular SQLite agent.db with mode0600 and effective-user ownership; no credential read/write APIs were called."
  },
